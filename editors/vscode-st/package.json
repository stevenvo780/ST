{
  "name": "st-symbolic-theory",
  "displayName": "ST — Symbolic Theory Language",
  "description": "Full IDE support for ST (Symbolic Theory Language) — Diagnostics, hover, completions, go-to-definition, folding, code actions, run & render for logic, proofs and text formalization.",
  "version": "0.3.0",
  "publisher": "StevenVallejo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenvo780/ST.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Education",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "st",
        "aliases": [
          "ST",
          "Symbolic Theory",
          "st"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "st",
        "scopeName": "source.st",
        "path": "./syntaxes/st.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "st.runFile",
        "title": "ST: Ejecutar archivo",
        "category": "ST",
        "icon": "$(play)"
      },
      {
        "command": "st.runSelection",
        "title": "ST: Ejecutar selección",
        "category": "ST",
        "icon": "$(play-circle)"
      },
      {
        "command": "st.render",
        "title": "ST: Renderizar a Markdown",
        "category": "ST",
        "icon": "$(markdown)"
      },
      {
        "command": "st.showProfile",
        "title": "ST: Mostrar perfil lógico",
        "category": "ST"
      }
    ],
    "keybindings": [
      {
        "command": "st.runFile",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == st"
      },
      {
        "command": "st.runSelection",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorLangId == st"
      },
      {
        "command": "st.render",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == st"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "st.runFile",
          "when": "editorLangId == st",
          "group": "navigation"
        },
        {
          "command": "st.render",
          "when": "editorLangId == st",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "st.runSelection",
          "when": "editorLangId == st",
          "group": "st@1"
        },
        {
          "command": "st.runFile",
          "when": "editorLangId == st",
          "group": "st@2"
        }
      ]
    },
    "configuration": {
      "title": "ST Language",
      "properties": {
        "st.diagnostics.enableRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar diagnósticos de runtime (ejecuta el archivo para detectar errores de evaluación)"
        },
        "st.diagnostics.enableParseDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Habilitar diagnósticos de parsing (errores de sintaxis)"
        },
        "st.completion.showKeywordsInSpanish": {
          "type": "boolean",
          "default": true,
          "description": "Incluir keywords en español en el autocompletado (axioma, teorema, etc.)"
        }
      }
    },
    "snippets": [
      {
        "language": "st",
        "path": "./snippets/st.json"
      }
    ]
  },
  "scripts": {
    "clean": "rm -rf dist vendor/st-lang *.vsix",
    "sync:st": "mkdir -p vendor/st-lang && rm -rf vendor/st-lang/dist && cp -R ../../dist vendor/st-lang/dist && cp ../../package.json vendor/st-lang/package.json",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run sync:st && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "files": [
    "dist",
    "LICENSE",
    "language-configuration.json",
    "vendor/st-lang/dist/**",
    "vendor/st-lang/package.json",
    "syntaxes/**",
    "snippets/**",
    "package.json"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
