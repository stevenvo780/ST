{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ST Symbolic Theory",
  "scopeName": "source.st",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.st", "match": "//.*$" },
        { "name": "comment.block.st", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.st",
          "match": "\\b(logic|axiom|axioma|theorem|teorema|claim|let|derive|derivar|check|verificar|prove|probar|countermodel|contramodel|refute|refutar|truth_table|tabla_verdad|explain|explicar|analyze|analizar|passage|formalize|support|confidence|context|import|importar|assume|asumir|show|demostrar|qed|render)\\b"
        },
        {
          "name": "constant.language.st",
          "match": "\\b(valid|valido|satisfiable|satisfacible|equivalent|equivalente)\\b"
        },
        {
          "name": "support.class.st",
          "match": "\\b(classical\\.propositional|classical\\.first_order|modal\\.k|paraconsistent\\.belnap|deontic\\.standard|epistemic\\.s5|intuitionistic\\.propositional|temporal\\.ltl|aristotelian\\.syllogistic|probabilistic\\.basic)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.logical.st", "match": "->|<->|&|\\||!|forall|paratodo|exists|existe|next|until" },
        { "name": "keyword.operator.modal.st", "match": "\\[\\]|<>|\\[\\]!" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.double.st", "begin": "\"", "end": "\"" },
        { "name": "string.other.passage.st", "begin": "\\[\\[", "end": "\\]\\]" }
      ]
    }
  }
}
