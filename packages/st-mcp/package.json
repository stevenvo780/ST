{
  "name": "@stevenvo780/st-mcp",
  "version": "0.1.0",
  "description": "MCP server exponiendo las tools core de ST (check / derive / countermodel / formalize) sobre 11 perfiles lógicos. Usable desde Claude Code, Cursor, ChatGPT con MCP y cualquier cliente compatible con el Model Context Protocol vía transport stdio.",
  "license": "MIT",
  "author": "Steven Vallejo <stevenvallejo780@gmail.com>",
  "homepage": "https://github.com/stevenvo780/ST#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevenvo780/ST.git",
    "directory": "packages/st-mcp"
  },
  "bugs": {
    "url": "https://github.com/stevenvo780/ST/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "logic",
    "formal-logic",
    "st-lang",
    "claude",
    "cursor",
    "anthropic",
    "ai-tools",
    "theorem-proving",
    "countermodel",
    "derivation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "st-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@stevenvo780/st-lang": "^4.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
