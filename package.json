{
  "name": "@stevenvo780/st-lang",
  "version": "4.9.0",
  "description": "ST — Lenguaje ejecutable con nucleo logico y capa textual. Motor multi-perfil (11 lógicas), derivaciones, tablas de verdad, contramodelos, aliases modales, Belnap 4-valores y capa textual para formalización de documentos.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "require": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/handler.d.ts",
      "require": "./dist/protocol/handler.js",
      "default": "./dist/protocol/handler.js"
    }
  },
  "bin": {
    "st": "./dist/cli/index.js"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "dist/**/*.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli/index.js",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:stress": "vitest run src/tests/stress-hardware.test.ts",
    "test:all": "bash ./scripts/run-exhaustive-validation.sh",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:save": "vitest bench --run --config vitest.bench.config.ts && cp benchmarks/results.json benchmarks/baselines.json",
    "bench:compare": "node scripts/bench/compare.mjs",
    "bench:v5": "vitest bench --run --config vitest.bench.v5.config.ts",
    "bench:v5:regression": "node scripts/bench/v5-regression.mjs",
    "bench:v5:update": "node scripts/bench/v5-regression.mjs --update",
    "examples:run": "bash ./scripts/run-all-examples.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "package": "./scripts/package.sh",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "prepack": "npm run build"
  },
  "keywords": [
    "logic",
    "formal",
    "propositional",
    "language",
    "cli",
    "repl",
    "truth-table",
    "derivation",
    "countermodel",
    "proof",
    "text-layer",
    "education"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stevenvo780/ST.git"
  },
  "homepage": "https://github.com/stevenvo780/ST#readme",
  "bugs": {
    "url": "https://github.com/stevenvo780/ST/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "fast-check": "^4.8.0",
    "prettier": "^3.8.1",
    "semver": "^7.8.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@stevenvo780/st-lang": "^4.6.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "z3-solver": "^4.16.0"
  }
}
